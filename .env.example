# Preferred model: provider:model_id
# Fallbacks are defined in src/providers/registry.py (not env).
LLM_MODEL=openai:gpt-5.6-luna

# API keys
PORTFOLIO_AGENT_GEMINI_API_KEY=
PORTFOLIO_AGENT_OPENAI_API_KEY=
PORTFOLIO_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Application
APP_VERSION=0.1.0
DEBUG=false
PORTFOLIO_WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","https://localhost:3000"]

# Session
SESSION_TTL_SECONDS=1800
SESSION_MAX_MESSAGES=20
